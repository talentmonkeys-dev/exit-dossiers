{
  "name": "TalentMonkeys Reply Handler",
  "nodes": [
    {
      "parameters": {
        "events": ["messageReceived"],
        "filters": {},
        "options": {
          "format": "full"
        }
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "notes": "Triggers on new email replies"
    },
    {
      "parameters": {
        "jsCode": "const negativeKeywords = [\n  \"kein interesse\", \"nicht interessiert\", \"keine weiteren\", \"bitte nicht mehr\",\n  \"abbestellen\", \"unsubscribe\", \"remove\", \"stop\", \"nein danke\", \"no thank\",\n  \"nicht kontaktieren\", \"aus dem verteiler\", \"kein bedarf\", \"nicht benötigt\",\n  \"please stop\", \"do not contact\", \"keine emails\", \"spam\",\n  \"entfernen sie mich\", \"abmelden\", \"nicht mehr kontaktieren\",\n  \"keine nachrichten\", \"keine e-mails\", \"keine mails\",\n  \"unerwünscht\", \"nicht erwünscht\", \"belästigung\"\n];\n\nconst positiveKeywords = [\n  \"interesse\", \"interessiert\", \"ja gerne\", \"vereinbaren\",\n  \"termin\", \"telefonat\", \"gespräch\", \"kontaktieren sie\",\n  \"rufen sie\", \"anrufen\", \"weiter\", \"mehr erfahren\",\n  \"sounds good\", \"let's talk\", \"call me\"\n];\n\n// Get email text\nconst emailText = ($json.textPlain || $json.snippet || $json.body?.text || '').toLowerCase();\nconst subject = ($json.subject || '').toLowerCase();\nconst fromEmail = $json.from?.emailAddress || $json.from || '';\n\n// Check for negative response\nconst isNegative = negativeKeywords.some(kw => \n  emailText.includes(kw) || subject.includes(kw)\n);\n\n// Check for positive response\nconst isPositive = positiveKeywords.some(kw => \n  emailText.includes(kw) || subject.includes(kw)\n) && !isNegative;\n\n// Extract original subject for reply\nlet originalSubject = $json.subject || '';\nif (!originalSubject.toLowerCase().startsWith('re:')) {\n  originalSubject = 'Re: ' + originalSubject;\n}\n\nreturn [{\n  json: {\n    isNegative,\n    isPositive,\n    emailText,\n    subject: $json.subject,\n    originalSubject,\n    fromEmail,\n    fromName: $json.from?.name || fromEmail.split('@')[0] || '',\n    messageId: $json.id || $json.messageId,\n    threadId: $json.threadId,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "detect-response-type",
      "name": "Detect Response Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "notes": "Detects if response is negative/positive"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-negative-check",
              "leftValue": "={{ $json.isNegative }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-negative",
      "name": "IF Negative",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300],
      "notes": "Checks if response is negative"
    },
    {
      "parameters": {
        "unit": "hours",
        "amount": 1
      },
      "id": "wait-1h",
      "name": "Wait 1 Hour",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 200],
      "notes": "Waits 1 hour before responding"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst vorname = data.fromName?.split(' ')[0] || 'Guten Tag';\nconst originalSubject = data.originalSubject || 'Re: Ihre Position';\n\nconst friendlyReply = `Hallo ${vorname},\n\nvielen Dank für Ihre Rückmeldung.\n\nSollte sich in Zukunft Bedarf ergeben, stehe ich gerne zur Verfügung.\n\nAlles Gute!\n\nBeste Grüße\nFlavio Arteaga\ntalentmonkeys GmbH`;\n\nreturn [{\n  json: {\n    ...data,\n    replySubject: originalSubject,\n    replyBody: friendlyReply,\n    vorname\n  }\n}];"
      },
      "id": "build-friendly-reply",
      "name": "Build Friendly Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200],
      "notes": "Creates polite acknowledgment"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.fromEmail }}",
        "subject": "={{ $json.replySubject }}",
        "message": "={{ $json.replyBody }}",
        "options": {
          "replyTo": "Flavio@talentmonkeys.com"
        }
      },
      "id": "gmail-friendly-reply",
      "name": "Gmail Friendly Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1100, 200],
      "notes": "Sends friendly acknowledgment"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "TalentMonkeys Leads",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Email",
              "lookupValue": "={{ $json.fromEmail }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "Abgelehnt",
            "Notizen": "=Negative Antwort erhalten: {{ $now.toFormat('yyyy-MM-dd HH:mm') }}"
          }
        },
        "options": {}
      },
      "id": "sheets-update-rejected",
