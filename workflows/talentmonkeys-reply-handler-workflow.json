    },
    {
      "parameters": {
        "sendTo": "Flavio@talentmonkeys.com",
        "subject": "=🎉 Positive Antwort von {{ $json.fromName }} ({{ $json.fromEmail }})",
        "message": "=Hallo Flavio,\n\nGute Nachrichten! Du hast eine positive Antwort erhalten:\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nVon: {{ $json.fromName }} <{{ $json.fromEmail }}>\nBetreff: {{ $json.subject }}\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n{{ $json.emailText }}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nBitte kontaktiere den Lead zeitnah!\n\nViele Grüße,\nDein n8n Workflow",
        "options": {}
      },
